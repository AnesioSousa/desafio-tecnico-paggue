# docker/php/Dockerfile.prod

# Imagem base PHP 8.2 com Apache
FROM php:8.2-apache

# 1) Instala dependências de sistema e extensões PHP
RUN apt-get update \
 && apt-get install -y \
    libpq-dev \
    libzip-dev \
    unzip \
    curl \
    git \
    zip \
 && docker-php-ext-install pdo pdo_pgsql zip \
 && pecl install redis \
 && docker-php-ext-enable redis \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# 2) Habilita mod_rewrite do Apache
RUN a2enmod rewrite

# 3) Ajusta Apache para apontar para public/ do Laravel
RUN sed -ri \
    -e 's!DocumentRoot /var/www/html!DocumentRoot /var/www/html/public!g' \
    /etc/apache2/sites-available/000-default.conf \
 && sed -ri \
    -e 's!<Directory /var/www/html>!<Directory /var/www/html/public>!g' \
    /etc/apache2/apache2.conf

# 4) Copia código-fonte da aplicação
WORKDIR /var/www/html
COPY src/ ./

# 5) Ajusta permissões
RUN chown -R www-data:www-data storage bootstrap/cache

# 6) Instala Composer e dependências de produção
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-ansi

# 7) Porta e comando padrão
EXPOSE 80
CMD ["apache2-foreground"]
